# Copy to .env and fill in. Only EMPORIA_* are required for live data.

# --- Emporia Vue (community pyemvue cloud login) ---
EMPORIA_USERNAME=you@example.com
EMPORIA_PASSWORD=your-emporia-password
# Optional: comma-separated device GIDs to record. Blank = all devices on the account.
EMPORIA_DEVICE_GIDS=

# --- App ---
# IANA timezone used for "today" and billing-cycle boundaries.
COMET_TZ=America/Chicago
# Host port the dashboard is published on.
COMET_PORT=8080
# Where /data (comet.db + emporia_tokens.json) lives on the host. Default (./data,
# relative to docker-compose.yml) is fine for plain `docker compose up` on a normal
# filesystem. On UNRAID via the Compose Manager plugin, set this to an ABSOLUTE path
# under /mnt/user/appdata (e.g. /mnt/user/appdata/comet) — Compose Manager resolves
# relative paths against its own project folder on /boot, the boot USB (vfat, no
# real Unix permissions), which breaks SQLite with "unable to open database file".
COMET_DATA_DIR=./data
# Set to 1 to run with simulated data and no credentials.
COMET_MOCK=0

# --- Polling (seconds) ---
PRICE_POLL_SECONDS=300
METER_POLL_SECONDS=60
